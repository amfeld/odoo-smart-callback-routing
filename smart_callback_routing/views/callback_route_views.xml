<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_scr_callback_route_list" model="ir.ui.view">
        <field name="name">scr.callback.route.list</field>
        <field name="model">scr.callback.route</field>
        <field name="arch" type="xml">
            <list string="Active Callback Mappings" create="false">
                <field name="phone_normalized"/>
                <field name="extension"/>
                <field name="extension_id" optional="hide"/>
                <field name="is_valid" column_invisible="1"/>
                <field name="created_at"/>
                <field name="expires_at" decoration-muted="not is_valid"/>
                <field name="last_call_id" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active" widget="boolean_toggle" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_scr_callback_route_form" model="ir.ui.view">
        <field name="name">scr.callback.route.form</field>
        <field name="model">scr.callback.route</field>
        <field name="arch" type="xml">
            <form string="Callback Mapping" create="false">
                <sheet>
                    <group>
                        <group>
                            <field name="phone_normalized"/>
                            <field name="extension"/>
                            <field name="extension_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="created_at"/>
                            <field name="expires_at"/>
                            <field name="last_call_id"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_scr_callback_route_search" model="ir.ui.view">
        <field name="name">scr.callback.route.search</field>
        <field name="model">scr.callback.route</field>
        <field name="arch" type="xml">
            <search string="Callback Mappings">
                <field name="phone_normalized"/>
                <field name="extension"/>
                <filter name="filter_active" string="Active" domain="[('active', '=', True)]"/>
                <filter name="filter_valid" string="Valid (not expired)"
                        domain="[('is_valid', '=', True)]"/>
                <group name="group_by">
                    <filter name="group_extension" string="Extension" context="{'group_by': 'extension'}"/>
                    <filter name="group_company" string="Company" context="{'group_by': 'company_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_scr_callback_route" model="ir.actions.act_window">
        <field name="name">Active Callback Mappings</field>
        <field name="res_model">scr.callback.route</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_scr_callback_route_search"/>
        <field name="context">{'search_default_filter_valid': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No callback mappings yet.</p>
            <p>Mappings are created automatically as soon as 3CX reports
               outbound events to the routing API.</p>
        </field>
    </record>

</odoo>
